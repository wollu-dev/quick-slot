# Copy this file to .env and change the values. (.env is not committed to git)

# Full site URL. Used to build alternate-language URLs (hreflang) and the canonical URL.
# If left empty, relative URLs are used instead (not needed during development).
SITE_URL=https://example.com

# Tools to hide, comma separated: tool slugs from src/tools/registry.ts or categories
# (file, pdf, image, media, text, dev, life). Empty shows every tool.
HIDE_TOOLS=
# Or the only tools or categories to show, in the same form. Empty shows every tool.
SHOW_TOOLS=
