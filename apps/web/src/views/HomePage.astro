---
/** 홈 화면. 언어별 페이지(src/pages/index.astro, src/pages/[lang]/index.astro)가 이 템플릿을 쓴다. */
import { ChevronRight, Cloud, LayoutGrid } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/ui/AppIcon';
import { getDict, type Lang } from '../i18n';
import { categories, categoryText, tools, toolText, toolUrl } from '../tools/registry';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<Layout lang={lang} path="/">
  <h1 class="sr-only">{t.meta.h1}</h1>

  <!-- 카테고리 필터: 본문과 같은 왼쪽 정렬, 모바일에서는 가로 스크롤 -->
  <div class="no-scrollbar -mx-4 mb-8 flex gap-2 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0" role="toolbar" aria-label={t.home.filters}>
    <button type="button" class="chip" data-filter="all" aria-pressed="true">
      <LayoutGrid size={15} strokeWidth={2.2} />
      {t.home.all}
      <span class="chip-count">{tools.length}</span>
    </button>
    {
      categories.map((c) => {
        const Icon = c.icon;
        return (
          <button type="button" class="chip" data-filter={c.id} aria-pressed="false">
            <Icon size={15} strokeWidth={2.2} color={c.color} />
            {categoryText(lang, c.id).name}
            <span class="chip-count">{tools.filter((x) => x.category === c.id).length}</span>
          </button>
        );
      })
    }
  </div>

  {
    categories.map((cat) => {
      const list = tools
        .filter((x) => x.category === cat.id)
        .sort((a, b) => (a.status === b.status ? 0 : a.status === 'ready' ? -1 : 1));
      const ct = categoryText(lang, cat.id);
      return (
        <section data-category={cat.id} class="mb-12">
          <div class="mb-4 flex items-baseline gap-3 px-1">
            <h2 class="text-[22px] font-bold tracking-tight">{ct.name}</h2>
            <span class="text-[14px] text-muted">{ct.description}</span>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((tool) => {
              const tt = toolText(lang, tool.slug);
              return (
                <a
                  href={toolUrl(tool.slug, lang)}
                  class="panel group flex items-center gap-3.5 p-3.5 pr-4 transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_14px_40px_-12px_rgb(0_0_0/0.22)]"
                >
                  <AppIcon tool={tool} size="md" className={tool.status === 'soon' ? 'opacity-45 grayscale-[0.4]' : ''} />
                  <span class="min-w-0 flex-1">
                    <span class="flex items-center gap-2">
                      <span class:list={['truncate text-[15px] font-semibold', tool.status === 'soon' && 'text-muted']}>{tt.name}</span>
                      {tool.status === 'soon' && (
                        <span class="shrink-0 rounded-full bg-panel-2 px-2 py-0.5 text-[11px] font-medium text-muted">{t.common.comingSoon}</span>
                      )}
                      {tool.processing === 'server' && <Cloud size={13} className="shrink-0 text-muted" aria-label={t.toolPage.server} />}
                    </span>
                    <span class="mt-0.5 block truncate text-[13px] text-muted">{tt.description}</span>
                  </span>
                  <ChevronRight size={17} className="shrink-0 text-muted/60 transition group-hover:translate-x-0.5" />
                </a>
              );
            })}
          </div>
        </section>
      );
    })
  }
</Layout>

<script>
  // 카테고리 필터. 선택은 주소의 #해시와 sessionStorage 에 남겨서,
  // 툴 페이지의 "‹ 툴 목록" 으로 돌아오면 마지막에 고른 필터 그대로 보인다.
  import { saveHomeFilter } from '../lib/homeFilter';

  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')];

  const apply = (filter: string) => {
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.filter === filter));
    for (const s of sections) s.hidden = filter !== 'all' && s.dataset.category !== filter;
    saveHomeFilter(filter);
  };

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter ?? 'all';
      apply(f);
      history.replaceState(null, '', f === 'all' ? location.pathname : `#${f}`);
    });
  }

  const initial = location.hash.slice(1);
  apply(chips.some((c) => c.dataset.filter === initial) ? initial : 'all');
</script>
