---
/**
 * Tool page. The per-language pages (src/pages/tools/[slug].astro, src/pages/[lang]/tools/[slug].astro) use this template.
 * For a tool with status: 'ready', add one line for its component under "Tool component wiring" below.
 * Tools that render the current time, random values or browser info on first paint use client:only="react" (avoids mismatches with the server-rendered output).
 */
import { ChevronLeft, Cloud, Hammer, Lock } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import SlotButton from '../components/SlotButton';
import AppIcon from '../components/ui/AppIcon';
import { getDict, localizePath, type Lang } from '../i18n';
import { getTool, toolText } from '../tools/registry';

import BatchRename from '../tools/file/BatchRename';
import FileConverter from '../tools/file/FileConverter';
import FileDateChanger from '../tools/file/FileDateChanger';
import MetadataRemover from '../tools/file/MetadataRemover';
import CharCounter from '../tools/text/CharCounter';
import Base64Tool from '../tools/dev/Base64Tool';
import JsonFormatter from '../tools/dev/JsonFormatter';
import UnixTimestamp from '../tools/dev/UnixTimestamp';
import UuidGenerator from '../tools/dev/UuidGenerator';
import PasswordGenerator from '../tools/dev/PasswordGenerator';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const tool = getTool(slug);
if (!tool) throw new Error(`Unknown tool (not in registry.ts): ${slug}`);
const t = getDict(lang);
const tt = toolText(lang, tool.slug);
---

<Layout lang={lang} path={`/tools/${slug}`} title={tt.name} description={tt.description} currentSlug={slug}>
  <!-- Returns to the filter last selected on the home page (the script below fills in href) -->
  <a href={localizePath(lang, '/')} data-back-link class="mb-6 inline-flex items-center gap-0.5 text-[15px] text-accent hover:opacity-80">
    <ChevronLeft size={19} strokeWidth={2.4} />
    {t.toolPage.back}
  </a>

  <div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-4">
    <AppIcon tool={tool} size="lg" />
    <div class="min-w-0 flex-1 basis-56">
      <h1 class="text-[26px] leading-tight font-bold tracking-tight break-keep sm:text-[32px]">{tt.name}</h1>
      <p class="mt-1 text-[15px] break-keep text-muted">{tt.description}</p>
    </div>
    <div class="flex w-full items-center gap-2 sm:w-auto">
      {
        tool.processing === 'client' ? (
          <span class="inline-flex h-9 items-center gap-1.5 rounded-full bg-ok/12 px-3.5 text-[13px] font-medium text-ok" title={t.toolPage.localTitle}>
            <Lock size={13} strokeWidth={2.4} />
            {t.toolPage.local}
          </span>
        ) : (
          <span class="inline-flex h-9 items-center gap-1.5 rounded-full bg-accent/12 px-3.5 text-[13px] font-medium text-accent" title={t.toolPage.serverTitle}>
            <Cloud size={13} strokeWidth={2.4} />
            {t.toolPage.server}
          </span>
        )
      }
      <SlotButton client:load lang={lang} slug={slug} />
    </div>
  </div>

  {/* ───── Tool component wiring ───── */}
  {slug === 'file-converter' && <FileConverter client:load lang={lang} />}
  {slug === 'batch-rename' && <BatchRename client:load lang={lang} />}
  {slug === 'file-date-changer' && <FileDateChanger client:only="react" lang={lang} />}
  {slug === 'metadata-remover' && <MetadataRemover client:load lang={lang} />}
  {slug === 'char-counter' && <CharCounter client:load lang={lang} />}
  {slug === 'json-formatter' && <JsonFormatter client:load lang={lang} />}
  {slug === 'base64' && <Base64Tool client:load lang={lang} />}
  {slug === 'unix-timestamp' && <UnixTimestamp client:only="react" lang={lang} />}
  {slug === 'uuid-generator' && <UuidGenerator client:only="react" lang={lang} />}
  {slug === 'password-generator' && <PasswordGenerator client:only="react" lang={lang} />}

  {
    tool.status === 'soon' && (
      <div class="panel flex flex-col items-center gap-2 px-6 py-20 text-center">
        <span class="mb-2 grid size-14 place-items-center rounded-full bg-panel-2 text-muted">
          <Hammer size={26} />
        </span>
        <p class="text-[17px] font-semibold">{t.toolPage.soonTitle}</p>
        <p class="text-[15px] text-muted">{t.toolPage.soonBody}</p>
      </div>
    )
  }
</Layout>

<script>
  import { splitLocale, localizePath } from '../i18n';
  import { readHomeFilter } from '../lib/homeFilter';

  const link = document.querySelector<HTMLAnchorElement>('[data-back-link]');
  if (link) {
    const { lang } = splitLocale(location.pathname);
    const filter = readHomeFilter();
    link.href = localizePath(lang, '/') + (filter === 'all' ? '' : `#${filter}`);

    // If we came straight from the home page, go back via browser history so the scroll position is restored too
    link.addEventListener('click', (e) => {
      try {
        const ref = new URL(document.referrer);
        if (ref.origin === location.origin && splitLocale(ref.pathname).path === '/' && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      } catch {
        /* No referrer → fall back to normal link navigation */
      }
    });
  }
</script>
