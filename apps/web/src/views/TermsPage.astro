---
/** Terms of service. The per-language pages (src/pages/terms.astro, src/pages/[lang]/terms.astro) use this template. */
import Layout from '../layouts/Layout.astro';
import Rich from '../i18n/Rich';
import { getDict, localizePath, type Lang } from '../i18n';
import { LICENSE_URL, REPO_URL } from '../lib/project';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const p = t.terms;
---

<Layout lang={lang} path="/terms" title={p.title} description={p.summary}>
  <article class="mx-auto max-w-3xl space-y-8 pb-6">
    <header class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight">{p.title}</h1>
      <p class="text-sm text-muted">{p.updated}</p>
      <p class="text-[15px] leading-relaxed"><Rich text={p.summary} /></p>
    </header>

    {
      p.sections.map((s) => (
        <section class="panel space-y-2 p-5">
          <h2 class="text-lg font-semibold">{s.heading}</h2>
          {s.body.map((para) => (
            <p class="text-[14px] leading-relaxed text-fg/90">
              <Rich text={para} />
            </p>
          ))}
        </section>
      ))
    }

    <section class="panel space-y-2 p-5">
      <h2 class="text-lg font-semibold">{p.relatedHeading}</h2>
      <ul class="list-disc space-y-1 pl-5 text-[14px]">
        <li><a class="text-accent underline" href={localizePath(lang, '/privacy')}>{t.footer.privacy}</a></li>
        <li><a class="text-accent underline" href={localizePath(lang, '/pricing')}>{t.footer.pricing}</a></li>
        {
          LICENSE_URL && (
            <li>
              <a class="text-accent underline" href={LICENSE_URL} target="_blank" rel="noopener noreferrer">
                {t.footer.license}
              </a>
            </li>
          )
        }
      </ul>
    </section>

    <section class="panel space-y-2 p-5">
      <h2 class="text-lg font-semibold">{t.privacy.contactHeading}</h2>
      <p class="text-[14px] leading-relaxed">
        {t.privacy.contact}
        {
          REPO_URL && (
            <>
              {' '}
              <a class="text-accent underline" href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer">
                {t.footer.issues}
              </a>
            </>
          )
        }
      </p>
    </section>
  </article>
</Layout>
