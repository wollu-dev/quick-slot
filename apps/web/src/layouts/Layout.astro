---
import '../styles/global.css';
import { Lock } from 'lucide-react';
import CommandPalette from '../components/CommandPalette';
import Dock from '../components/Dock';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  /** 지금 열려 있는 툴 (독에 표시 점) */
  currentSlug?: string;
}

const { title, currentSlug, description = '설치 없이 브라우저에서 바로 쓰는 생활·개발 도구 모음. 파일은 서버로 올라가지 않습니다.' } = Astro.props;
const fullTitle = title ? `${title} · QuickSlot` : 'QuickSlot · 필요한 도구를 바로 꺼내 쓰세요';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1c1f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 px-4 pt-3">
      <!-- 로고 | 가운데 검색 | (빈 칸) — 검색이 정확히 가운데 오도록 양옆을 같은 폭으로 -->
      <div class="glass mx-auto grid h-14 max-w-6xl grid-cols-[auto_1fr] items-center gap-3 rounded-full pr-2 pl-3 sm:grid-cols-[1fr_minmax(0,440px)_1fr]">
        <a href="/" class="flex shrink-0 items-center gap-2.5 text-[17px] font-semibold tracking-tight" aria-label="QuickSlot 홈">
          <Logo size={30} />
          <span class="hidden sm:inline">QuickSlot</span>
        </a>
        <CommandPalette client:load />
        <span class="hidden sm:block" aria-hidden="true"></span>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 pt-8 pb-12 sm:px-6">
      <slot />
    </main>

    <!-- 하단 독 높이만큼 여백 -->
    <footer class="mx-auto flex max-w-6xl items-center justify-center gap-1.5 px-4 pb-28 text-center text-[13px] text-muted sm:pb-32">
      <Lock size={13} strokeWidth={2.2} />
      브라우저에서 처리하는 툴은 파일을 서버로 보내지 않습니다.
    </footer>

    <Dock client:load currentSlug={currentSlug} />
  </body>
</html>
