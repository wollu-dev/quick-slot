---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette';
import Dock from '../components/Dock';
import SettingsSheet from '../components/SettingsSheet';
import LanguageSuggest from '../components/LanguageSuggest';
import Logo from '../components/Logo.astro';
import GithubMark from '../components/GithubMark.astro';
import { REPO_URL } from '../lib/project';
import { LOCALES, getDict, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Path without the language prefix (e.g. '/', '/tools/base64') — used for alternate-language links (hreflang) */
  path: string;
  title?: string;
  description?: string;
  /** The currently open tool (marked with a dot in the dock) */
  currentSlug?: string;
}

const { lang, path, title, currentSlug } = Astro.props;
const t = getDict(lang);
const description = Astro.props.description ?? t.meta.siteDescription;
const fullTitle = title ? `${title} · QuickSlot` : t.meta.siteTitle;

/** URLs for search engines: absolute (https://…) if SITE_URL is set, otherwise relative (see astro.config.mjs) */
const absolute = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
---

<!doctype html>
<html lang={lang} data-dock="bottom" data-dock-size="m">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafafc" />
    <!--
      Runs before first paint: applies theme and dock position/size, and redirects to the chosen language if one is set.
      The rules mirror src/lib/theme.ts, src/lib/dock.ts and src/i18n/index.tsx (keep storage keys and defaults in sync).
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function get(k) {
          try {
            return localStorage.getItem(k);
          } catch (e) {
            return null;
          }
        }

        // Language: if the language chosen in settings differs from the page language, go to this page in that language
        var want = get('quickslot:lang');
        var page = root.lang;
        if ((want === 'ko' || want === 'en' || want === 'ja') && want !== page) {
          var rest = location.pathname.replace(/^\/(en|ja)(?=\/|$)/, '') || '/';
          location.replace((want === 'ko' ? '' : '/' + want) + rest + location.search + location.hash);
          return;
        }

        // Theme
        var pref = get('quickslot:theme') || 'system';
        var dark = pref === 'dark' || (pref !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#1c1c1f' : '#fafafc');

        // Dock position/size
        try {
          var dock = JSON.parse(get('quickslot:dock') || '{}');
          if (/^(left|bottom|right)$/.test(dock.position)) root.dataset.dock = dock.position;
          if (/^(s|m|l)$/.test(dock.size)) root.dataset.dockSize = dock.size;
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={absolute(localizePath(lang, path))} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={absolute(localizePath(l, path))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(localizePath('ko', path))} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 px-4 pt-3">
      <!-- Logo on the left · search + settings on the right -->
      <div class="glass mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 rounded-full pr-2.5 pl-3">
        <a href={localizePath(lang, '/')} class="flex shrink-0 items-center gap-2.5 text-[17px] font-semibold tracking-tight" aria-label={t.header.home}>
          <Logo size={30} />
          <span class="hidden sm:inline">QuickSlot</span>
        </a>
        <div class="flex w-full max-w-[360px] min-w-0 items-center gap-2">
          <div class="min-w-0 flex-1">
            <CommandPalette client:load lang={lang} />
          </div>
          <SettingsSheet client:load lang={lang} />
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 pt-8 pb-12 sm:px-6">
      <!-- If the browser language differs, only "suggest" viewing in it (no auto-redirect, since that would block search engine indexing) -->
      <LanguageSuggest client:only="react" lang={lang} />
      <slot />
    </main>

    <!--
      Quiet footer in the style of Apple's site: hairlines and small gray text, left-aligned with the content.
      .dock-safe adds bottom padding so the footer is not hidden behind the dock.
    -->
    <footer class="dock-safe mx-auto max-w-6xl px-4 text-[12px] leading-relaxed text-muted sm:px-6">
      <div class="flex flex-col gap-3 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
        <p>{t.footer.copyright(new Date().getFullYear())}</p>

        {
          REPO_URL && (
            <nav aria-label={t.footer.links} class="flex flex-wrap items-center gap-y-1 divide-x divide-line">
              <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="footer-link pr-3">
                <GithubMark size={13} />
                {t.footer.github}
              </a>
              <a href={`${REPO_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="footer-link px-3">
                {t.footer.license}
              </a>
              <a href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer" class="footer-link pl-3">
                {t.footer.issues}
              </a>
            </nav>
          )
        }
      </div>
    </footer>

    <Dock client:load lang={lang} currentSlug={currentSlug} />
  </body>
</html>
