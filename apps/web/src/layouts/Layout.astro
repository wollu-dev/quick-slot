---
import '../styles/global.css';
import { Lock } from 'lucide-react';
import CommandPalette from '../components/CommandPalette';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  /** 페이지 본문에 큰 검색창이 있으면 헤더 검색 버튼을 숨긴다 */
  hideHeaderSearch?: boolean;
}

const { title, hideHeaderSearch = false, description = '설치 없이 브라우저에서 바로 쓰는 생활·개발 도구 모음. 파일은 서버로 올라가지 않습니다.' } = Astro.props;
const fullTitle = title ? `${title} · QuickSlot` : 'QuickSlot · 필요한 도구를 바로 꺼내 쓰세요';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 px-4 pt-3">
      <div class="glass mx-auto flex h-14 max-w-6xl items-center gap-4 rounded-full pr-2 pl-3">
        <a href="/" class="flex shrink-0 items-center gap-2.5 text-[17px] font-semibold tracking-tight">
          <Logo size={30} />
          <span>QuickSlot</span>
        </a>
        <div class="flex flex-1 justify-end">
          <CommandPalette client:load showTrigger={!hideHeaderSearch} />
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 pt-10 pb-16 sm:px-6">
      <slot />
    </main>

    <footer class="mx-auto flex max-w-6xl items-center justify-center gap-1.5 px-4 pb-10 text-center text-[13px] text-muted">
      <Lock size={13} strokeWidth={2.2} />
      브라우저에서 처리하는 툴은 파일을 서버로 보내지 않습니다.
    </footer>
  </body>
</html>
