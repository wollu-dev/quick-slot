---
import Layout from '../layouts/Layout.astro';
import SlotBar from '../components/SlotBar';
import { categories, tools, toolUrl } from '../tools/registry';

const readyCount = tools.filter((t) => t.status === 'ready').length;
---

<Layout>
  <section class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">필요한 도구, 바로 꺼내 쓰세요</h1>
    <p class="mt-2 text-muted">
      설치도 가입도 없이. 파일은 내 PC를 떠나지 않습니다. <span class="text-fg">{readyCount}개</span> 사용 가능,
      계속 추가 중.
    </p>
    <p class="mt-3 text-sm text-muted">
      <span class="kbd">Ctrl K</span> 검색 · 툴 페이지에서 <span class="text-accent">☆ 퀵슬롯 등록</span> 후
      <span class="kbd">Alt 1~9</span> 로 바로 열기
    </p>
  </section>

  <section class="mb-12">
    <h2 class="mb-3 text-sm font-semibold text-muted">내 퀵슬롯</h2>
    <SlotBar client:load />
  </section>

  {
    categories.map((cat) => {
      const list = tools
        .filter((t) => t.category === cat.id)
        .sort((a, b) => (a.status === b.status ? 0 : a.status === 'ready' ? -1 : 1));
      return (
        <section id={cat.id} class="mb-10 scroll-mt-20">
          <h2 class="mb-3 flex items-baseline gap-2 text-lg font-semibold">
            <span>{cat.icon}</span>
            {cat.name}
            <span class="text-xs font-normal text-muted">{cat.description}</span>
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((tool) => (
              <a
                href={toolUrl(tool.slug)}
                class:list={[
                  'panel block p-4 transition hover:-translate-y-0.5 hover:border-accent',
                  tool.status === 'soon' && 'opacity-50',
                ]}
              >
                <div class="flex items-center justify-between gap-2">
                  <span class="font-medium">{tool.name}</span>
                  {tool.status === 'soon' && <span class="text-[11px] text-muted">준비 중</span>}
                  {tool.processing === 'server' && <span class="text-[11px] text-accent">☁️ 서버</span>}
                </div>
                <p class="mt-1 text-sm text-muted">{tool.description}</p>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }
</Layout>
