---
import PricingPage from '../../views/PricingPage.astro';
import { LOCALES, DEFAULT_LANG, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<PricingPage lang={lang} />
