# Settings for the API server (apps/api). Copy to .env or set them in docker-compose.yml.

# Port the API listens on
PORT=8787

# Behind the bundled nginx (or another reverse proxy), read the client address from X-Forwarded-For.
# Leave false when the API is reached directly, or clients could fake their address.
TRUST_PROXY=false

# Requests allowed per client address per minute, across all API routes
RATE_LIMIT_PER_MINUTE=60

# One line per request with method, path (no query), status and time. Never contains what users send.
LOG_REQUESTS=true

# Server time checks per client address per minute (each check sends about 20 requests to the site)
SERVER_TIME_PER_MINUTE=6

# Video downloader (yt-dlp, plus ffmpeg to merge video and audio, must be installed; the Docker image has both)
YTDLP_PATH=yt-dlp
# Largest file in MB and longest video in minutes
VIDEO_MAX_MB=1024
VIDEO_MAX_MINUTES=120
# Downloads running at once on the server, and per client address per hour
VIDEO_CONCURRENT=2
VIDEO_PER_HOUR=10
# Where downloads wait until they are sent (each is deleted right after). Defaults to the system temp folder
# VIDEO_WORK_DIR=/work
