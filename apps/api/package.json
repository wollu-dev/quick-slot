{
  "name": "@quickslot/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Server side of the few QuickSlot tools that can't run in the browser",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
