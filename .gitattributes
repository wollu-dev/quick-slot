# Normalize line endings to LF in the repo (keeps diffs clean across Windows/macOS)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files (no line-ending conversion, no diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wasm binary
*.mp3 binary
*.mp4 binary

# Exclude lock files from GitHub language stats
package-lock.json linguist-generated=true
