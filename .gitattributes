# 줄바꿈을 저장소에서는 LF 로 통일 (Windows/macOS 혼용 시 diff 오염 방지)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 바이너리 (줄바꿈 변환·diff 금지)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wasm binary
*.mp3 binary
*.mp4 binary

# GitHub 언어 통계에서 lock 파일 제외
package-lock.json linguist-generated=true
